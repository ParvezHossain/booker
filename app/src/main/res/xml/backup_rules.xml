<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude sensitive session tokens, reading store, cursors, and private PDF files from auto-backup -->
    <exclude domain="sharedpref" path="booker_local_reading_store.xml" />
    <exclude domain="sharedpref" path="booker_sse_cursors.xml" />
    <exclude domain="file" path="pdf_cache" />
</full-backup-content>